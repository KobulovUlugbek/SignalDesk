{
  "name": "signaldesk-studio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n api,frontend -c green,cyan \"php artisan serve --host=127.0.0.1 --port=8000\" \"vite --host=127.0.0.1\"",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test:php": "php artisan test",
    "test": "npm run typecheck && npm run test:php",
    "start": "php artisan serve --host=0.0.0.0 --port=8000",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm run typecheck && npm run build",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "laravel-vite-plugin": "^2.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
